(defpoll lyrics_text
  :interval "200ms"
  :initial ". . ."
  `bash -c '"$HOME/.config/eww/scripts/poll-lyrics.sh"'`)

(defpoll track_info
  :interval "1s"
  :initial "—"
  `playerctl --player=spotify metadata --format '{{artist}} — {{title}}'`)

(defwindow spotify_lyrics_preview
  :monitor 0
  :class "spotify-lyrics-preview"
  :namespace "spotify-lyrics-preview"
  :stacking "overlay"
  :exclusive false
  :focusable "false"
  :geometry (geometry
    :anchor "top left"
    :x "800px"
    :y "4px"
    :height "24px")
  (box
    :class "spotify-lyrics-root"
    :orientation "horizontal"
    :spacing 6
    :space-evenly false
    :halign "start"
    :valign "center"
    (box
      :class "left-section"
      :orientation "horizontal"
      :spacing 6
      :hexpand false
      (image
        :class "spotify-logo"
        :path "$HOME/.config/eww/assets/spotify.svg"
        :valign "center"
        :halign "center"
        :hexpand false
        :image-width 14
        :image-height 14)
      (label
        :class "track-info"
        :text track_info
        :wrap false
        :truncate true
        :width 200
        :hexpand false
        :halign "start"
        :valign "center"))
    (label
      :class "lyrics-text"
      :markup lyrics_text
      :wrap false
      :truncate false
      :hexpand false
      :halign "start"
      :valign "center")))
